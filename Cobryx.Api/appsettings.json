{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=your_host;Database=your_db;Username=your_user;Password=your_password"
  },
  "JwtSettings": {
    "Secret": "",
    "Issuer": "CobryxApi",
    "Audience": "CobryxClient",
    "ExpiryMinutes": 60
  },
  "App": {
    "BaseUrl": "https://cobros.com.mx",
    "AppUrl": "https://app.cobros.com.mx",
    "DocsUrl": "https://docs.api.cobros.com.mx"
  },
  "Email": {
    "SmtpHost": "localhost",
    "SmtpPort": "25",
    "SmtpUsername": "",
    "SmtpPassword": "",
    "FromAddress": "[EMAIL_ADDRESS]"
  },
  "OAuth": {
    "Google": {
      "ClientId": "YOUR_WEB_CLIENT_ID,YOUR_ANDROID_CLIENT_ID"
    }
  },
  "Fido2": {
    "Origin": "https://app.cobros.com.mx",
    "ServerDomain": "app.cobros.com.mx"
  },
  "Storage": {
    "S3": {
      "AccessKey": "",
      "SecretKey": "",
      "ServiceUrl": "",
      "BucketName": "documents"
    }
  },
  "Security": {
    "ClamAV": {
      "Host": "localhost",
      "Port": "3310"
    },
    "Captcha": {
      "SecretKey": "",
      "SiteKey": ""
    }
  },
  "Caching": {
    "Redis": {
      "ConnectionString": "localhost:6379"
    },
    "DefaultTTL": "300"
  },
  "Stripe": {
    "SecretKey": "",
    "WebhookSecret": "",
    "SuccessUrl": "https://app.cobros.com.mx/billing/success",
    "CancelUrl": "https://app.cobros.com.mx/billing/cancel"
  },
  "ENABLE_SWAGGER": false,
  "ENABLE_MIGRATION": false
}
