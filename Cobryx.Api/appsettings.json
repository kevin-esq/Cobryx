{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=aws-0-us-west-2.pooler.supabase.com;Database=postgres;Username=postgres;Password=YOUR_PASSWORD;SSL Mode=Require;Keepalive=30"
  },
  "JwtSettings": {
    "Secret": "YOUR_JWT_SECRET_MIN_32_CHARS",
    "Issuer": "Cobryx",
    "Audience": "Cobryx",
    "ExpiryMinutes": "15"
  },
  "Storage": {
    "AzureBlob": {
      "ConnectionString": "UseDevelopmentStorage=true",
      "ContainerName": "documents"
    }
  },
  "Security": {
    "ClamAV": {
      "Host": "clamav",
      "Port": "3310"
    }
  }
}
