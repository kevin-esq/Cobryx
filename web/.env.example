# Public API base URL used by the browser client. Must point to a running Cobryx.Api instance.
NEXT_PUBLIC_API_URL=http://localhost:5142

# Server-side only API URL (defaults to NEXT_PUBLIC_API_URL if not set).
# Useful when SSR/Route Handlers need to talk to the API through an internal hostname.
API_URL=http://localhost:5142

# Preferred server-only URL for auth BFF route handlers (defaults to API_URL).
INTERNAL_API_URL=http://localhost:5142
